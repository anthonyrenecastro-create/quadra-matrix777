# Quadra Matrix A.I. Environment Configuration
# Copy this file to .env and customize for your environment

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
HOST=0.0.0.0
PORT=5000

# Paths
MODEL_ARTIFACTS_DIR=./models
DASHBOARD_STATE_DIR=./dashboard_state
LOGS_DIR=./logs
DATA_DIR=./data

# Model Configuration
FIELD_SIZE=100
NUM_BATCHES=100
BATCH_SIZE=5
LEARNING_RATE=0.001
DEVICE=cpu

# Dataset Configuration
DATASET_NAME=wikitext
DATASET_CONFIG=wikitext-2-raw-v1

# Logging
LOG_LEVEL=INFO

# Performance
MAX_WORKERS=4
SAVE_INTERVAL=10

# Socket.IO (optional)
SOCKETIO_MESSAGE_QUEUE=
SOCKETIO_ASYNC_MODE=eventlet

# Docker (for docker-compose)
HOST_PORT=5000

# =============================================================================
# ML-SPECIFIC FEATURES
# =============================================================================

# Authentication
QUADRA_AUTH_ENABLED=false
QUADRA_SECRET_KEY=change-this-to-a-long-random-string-in-production
QUADRA_TOKEN_EXPIRY_HOURS=24

# API Keys (Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
# QUADRA_API_KEY=your-api-key-here
# QUADRA_ADMIN_API_KEY=your-admin-key-here

# Rate Limiting
QUADRA_RATE_LIMIT_ENABLED=true
QUADRA_MAX_REQUESTS=100
QUADRA_RATE_WINDOW=60

# Model Versioning
QUADRA_MODELS_DIR=./dashboard_state/models
QUADRA_AUTO_VERSION=true
QUADRA_VERIFY_INTEGRITY=true

# Model Monitoring
QUADRA_MONITORING_DIR=./dashboard_state/monitoring
QUADRA_DRIFT_THRESHOLD=2.0
QUADRA_MONITORING_WINDOW=1000
QUADRA_AUTO_BASELINE=false

# Model Mode
QUADRA_INITIAL_MODE=inference

# Health Checks
QUADRA_HEALTH_CHECK_INTERVAL=60
QUADRA_REQUIRED_FILES=model_registry.json
